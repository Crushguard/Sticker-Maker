rules_version = '2';

// Bucket play-console-f33dd-stickermaker. public/ holds the generated, immutable pack and catalog files the app
// downloads; library/ holds the source art and is uploaded through the console or gcloud (IAM, not these rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{allPaths=**} {
      allow get: if true;
      allow list, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
