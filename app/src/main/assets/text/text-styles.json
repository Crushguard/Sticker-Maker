{
 "canvas": 512,
 "note": "Text layer styles. Sizes are in px at 512; the default caption is 52 px and auto-fits to 30 characters / 2 lines. paintOrder stroke-first everywhere. The die-cut outline (see outline styles) wraps text and subject together afterwards.",
 "styles": [
  {
   "id": "classic",
   "label": "Classic",
   "fill": "{colour}",
   "strokeWidth": 0,
   "shadow": {
    "dx": 0,
    "dy": 3,
    "blur": 0,
    "colour": "#1E2128"
   },
   "shadow2": {
    "dx": 0,
    "dy": 0,
    "blur": 12,
    "colour": "rgba(0,0,0,.35)"
   },
   "font": "ui"
  },
  {
   "id": "sticker",
   "label": "Sticker",
   "fill": "{colour}",
   "strokeWidth": 0.16,
   "strokeUnit": "em",
   "strokeColour": "#FFFFFF",
   "shadow": {
    "dx": 0,
    "dy": 3,
    "blur": 3,
    "colour": "rgba(0,0,0,.18)"
   },
   "font": "lettering"
  },
  {
   "id": "stroke",
   "label": "Bold stroke",
   "fill": "#FFFFFF",
   "strokeWidth": 0.2,
   "strokeUnit": "em",
   "strokeColour": "{colour}",
   "shadow": null,
   "font": "lettering"
  },
  {
   "id": "bubble",
   "label": "Bubble",
   "fill": "#1E2128",
   "strokeWidth": 0,
   "bubble": {
    "fill": "#FFFFFF",
    "border": 5,
    "borderColour": "#1E2128",
    "radius": 28,
    "padding": [
     12,
     22
    ],
    "tail": {
     "w": 26,
     "h": 20,
     "side": "bottom-start"
    }
   },
   "font": "lettering"
  }
 ],
