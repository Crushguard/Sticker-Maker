# Parameters of the stickermaker functions (index.js). Empty values keep the feature off.
# GA4_PROPERTY_ID: Analytics property id for weekly pack popularity from the pack_added event.
GA4_PROPERTY_ID=
# PUBLIC_URL_TEMPLATE: where the app fetches public files, e.g. https://cdn.example.com/{rawPath}; empty = Firebase Storage.
PUBLIC_URL_TEMPLATE=
