{
  "firestore": {
    "database": "stickermaker",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "bucket": "play-console-f33dd-stickermaker",
      "rules": "storage.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "stickermaker",
      "runtime": "nodejs24",
      "ignore": ["node_modules", ".git", "test", "*.log"]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "functions": { "port": 5001 },
    "tasks": { "port": 9499 },
    "ui": { "enabled": false }
  }
}
