rules_version = '2';

// Love Stickers (database "stickermaker"). The app reads one document, catalog/meta, which points at the
// catalog file in Storage. Everything else is written and read only by the stickermaker Cloud Functions
// (Admin SDK, which bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /catalog/meta {
      allow get: if true;
      allow list, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
